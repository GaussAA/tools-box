# 工具箱代码格式配置。规则对应 docs/coding-standards.md 的命名与格式章节。
#
# 本文件是按现有代码的实际风格倒推出来的，用途是**统一人写代码时的判断**，
# 不是拿去批量重排。已用 VS 自带的 clang-format 实跑校验过，结论是：
#
#   约束不了现状，不能当强制检查用。实测会让 14 个文件 / 约 330 行发生改动，
#   原因是 clang-format 没有「保留手工换行」的选项，而且按字符数而不是中文双宽
#   算列宽 —— 现有代码里手工折断的长调用、手工对齐的 lambda 实参都会被重排。
#
# 真想启用它，必须单独提一个「只做格式归一化」的提交，并把该提交登记进
# .git-blame-ignore-revs，否则会污染历史 blame。取舍与依据见
# docs/workflow.md §3.1 与 docs/architecture.md §9 的偏差 9.9。
#
# 现有风格并不是纯粹的 Allman：函数/类/结构体/枚举的 { 独占一行，但控制语句
# 和 namespace 的 { 留在行尾，所以只能用 BreakBeforeBraces: Custom 逐项指定。

Language: Cpp
BasedOnStyle: LLVM
Standard: c++17

# ── 缩进与行宽 ────────────────────────────────────────────
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# 访问修饰符顶格，成员相对缩进 4
AccessModifierOffset: -4

# ── 大括号 ────────────────────────────────────────────────
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterStruct: true
  # 短枚举写作 enum class FetchKind { None, YtDlp, Ffmpeg };，不展开。
  # clang-format 只有一个全局开关（AfterEnum），无法同时表达「短枚举一行、
  # 长枚举把 { 另起一行」，实测取 false 时全仓改动更少
  AfterEnum: false
  AfterUnion: true
  AfterFunction: true
  # 控制语句写作 if (cond) {，不换行
  AfterControlStatement: Never
  # namespace 写作 namespace toolbox {
  AfterNamespace: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# 现有代码的条件分支都带大括号、且不写成一行
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
# 短枚举保持一行（见 BreakBeforeBraces.AfterEnum 的说明）
AllowShortEnumsOnASingleLine: true
# 头文件里有 { return m_entries; } 这种单行访问器
AllowShortFunctionsOnASingleLine: Inline
# 单行 lambda 当作实参传入时保持一行（QTimer::singleShot(0, this, [this] { ... });）
AllowShortLambdasOnASingleLine: Inline

# ── 符号位置 ──────────────────────────────────────────────
# 现有代码写作 QWidget *parent / const QString &text
PointerAlignment: Right
ReferenceAlignment: Pointer
DerivePointerAlignment: false

# ── 换行后的缩进 ──────────────────────────────────────────
# 超长调用换行后对齐到左括号（现有代码多数如此）
AlignAfterOpenBracket: Align
ContinuationIndentWidth: 4
# 长表达式换行时，运算符留在行首（qEnvironmentVariable(...) / + QStringLiteral(...)），
# 三目也写成 ? / : 各自另起一行
BreakBeforeBinaryOperators: NonAssignment
AlignOperands: DontAlign
# 长字符串字面量整体下移，不要被切成几段拼接
BreakStringLiterals: false

# ── 类与函数 ──────────────────────────────────────────────
# 构造初始化列表：逗号在行首（": QMainWindow(parent)" 换行后 ", m_x(...)"）
BreakConstructorInitializers: BeforeComma
# namespace 内部不缩进；收尾注释保留（} // namespace）
NamespaceIndentation: None
FixNamespaceComments: true
# 空行最多保留 1 行
MaxEmptyLinesToKeep: 1
# 预处理指令顶格
IndentPPDirectives: None

# ── 注释 ──────────────────────────────────────────────────
# 注释是中文且已经手工排过版，绝对不要让 clang-format 重排
ReflowComments: false
# 成员声明后的 ///< 尾注释是手工对齐的，交给 clang-format 只会挪位
AlignTrailingComments:
  Kind: Leave

# ── include 顺序 ──────────────────────────────────────────
# 必须保持 Preserve：插件 .cpp 末尾的 #include "Xxx.moc" 依赖它在最后一行，
# 一旦被合并进上面的分组并重排，moc 的包含顺序就会出错导致编译失败。
IncludeBlocks: Preserve
SortIncludes: CaseSensitive
